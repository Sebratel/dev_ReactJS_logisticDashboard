	column 'Grupo Item' = ```
			
			IF (
			    CONTAINSSTRING ( LOWER ( general[Item] ), "notebook" ),
			    "Notebooks",
			    "Outros"
			)
			
			```
		lineageTag: d6ee8b78-d038-40ff-b6b4-5710f63f217b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition general = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select#(lf)p.code,#(lf)p.tag_number as ""Patrimonio"",#(lf)p.serial_number#(tab)as ""Serial"",#(lf)p.title as ""Item"",#(lf)p.active as ""Ativo"",#(lf)p.p_is_disponible as ""Disponível"",#(lf)cp.description as ""Base"",#(lf)p2.name as ""Responsável"",#(lf)p3.name as ""Fornecedor"",#(lf)p.invoice_number as ""Nota Fiscal"",#(lf)p.purchase_date as ""Data Compra"",#(lf)p.created as ""Data Criado"",#(lf)u.name as ""Criado Por"",#(lf)u2.name as ""Modificado Por"",#(lf)p.purchase_amount as ""Valor"",#(lf)p.observation as ""Observação"",#(lf)p.last_occurrence_description as ""Ultimo Registro"",#(lf)p.modified as ""Data Modificado""#(lf)from patrimonies p#(lf)left join company_place_business_units cp on cp.id = p.company_place_business_unit_id#(lf)left join people p2 on p2.id = p.person_id#(lf)left join people p3 on p3.id = p.supplier_id#(lf)left join users u on u.id = p.created_by #(lf)left join users u2 on u2.id = p.modified_by #(lf)---where p.title ILIKE '%notebook%'"),
				    #"Valor Substituído" = Table.ReplaceValue(Fonte,"1","Ativo",Replacer.ReplaceText,{"Ativo"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","0","Desativado",Replacer.ReplaceText,{"Ativo"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído1","1","Disponível",Replacer.ReplaceText,{"Disponível"}),
				    #"Valor Substituído3" = Table.ReplaceValue(#"Valor Substituído2","0","Indisponível",Replacer.ReplaceText,{"Disponível"}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Valor Substituído3",{{"Valor", Currency.Type}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

