# Modelo de configuração — só os NOMES. Os valores reais ficam no .env de cada
# ambiente (nunca versionado) ou nas variáveis da stack no Portainer.
#
# Em desenvolvimento o servidor também lê os .env das pastas ACIMA do projeto
# (ex.: o .env compartilhado da pasta de trabalho), então não é preciso copiar
# as credenciais para cá. Em produção isso fica desligado.

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
PORT=8080
# local: 127.0.0.1 deixa o painel fora da rede (principalmente com AUTH_ENABLED=false)
HOST=0.0.0.0
# saltos de proxy reverso à frente do contêiner (0 = acesso direto)
TRUST_PROXY=0
# atualização das fontes (ms) — de hora em hora
REFRESH_INTERVAL_MS=3600000
# tela de Compras (lançamento e saldos): releitura a cada minuto (mínimo 30000)
LIVE_REFRESH_INTERVAL_MS=60000
# tela do laboratório (entrada/saída): releitura a cada 3 horas (mínimo 60000)
LAB_REFRESH_INTERVAL_MS=10800000
# teto de UMA consulta no Voalle (a view de alocações leva ~7 min)
QUERY_TIMEOUT_MS=900000

# ---------------------------------------------------------------------------
# Voalle (PostgreSQL) — no Power BI era o DSN "dbVoalle"
# (também aceita os nomes DB_ELLEVEN_*)
# ---------------------------------------------------------------------------
DB_VOALLE_HOST=
DB_VOALLE_PORT=5432
DB_VOALLE_DATABASE=
DB_VOALLE_USER=
DB_VOALLE_PASSWORD=
# opcional: schema das tabelas, se o search_path do usuário não for o do ERP
DB_VOALLE_SCHEMA=
DB_VOALLE_POOL_MAX=3

# ---------------------------------------------------------------------------
# MariaDB (base de colaboradores da Senior) — no Power BI era o DSN "dbMaria"
# ---------------------------------------------------------------------------
DB_MARIA_HOST=
DB_MARIA_PORT=3306
DB_MARIA_USER=
DB_MARIA_PASSWORD=

# ---------------------------------------------------------------------------
# Dados do próprio app: controle de estoque (stock-controls.json), usuários e
# permissões (users.json) e log de edições (audit-log.json).
# Padrão: server/data local e /app/data no contêiner — em produção, um volume.
# ---------------------------------------------------------------------------
DATA_PATH=

# ---------------------------------------------------------------------------
# Login com Google (mesmo projeto OAuth das outras dashboards)
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
# ID do cliente OAuth (público). Também aceita VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=sebratel.com.br
# Admin(s) de fábrica, separados por vírgula. Só valem enquanto NÃO houver
# nenhum admin salvo no cadastro de usuários (instalação nova); depois disso as
# permissões (Padrão, Edição, Admin) são dadas na tela de Administração.
# Em branco = gustavo.santos@sebratel.com.br
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Recortes de data (os das consultas do Power BI; alocações e histórico de romaneios
# de patrimônio, que o Power BI lia desde 2024, passaram a 2026 em 10/11/2026)
# ---------------------------------------------------------------------------
CONSUMPTION_SINCE=2026-01-01
PRODUCT_PACKING_SINCE=2025-01-01
PATRIMONY_PACKING_SINCE=2026-01-01
PATRIMONY_NOTES_SINCE=2026-01-01
# pedidos de compra da tela de Compras (o Power BI "CMP" fixava 01/01/2026)
PURCHASE_ORDERS_SINCE=2026-01-01
# equipamentos para campo (o Power BI "CTR" mostrava de 2025 em diante)
FIELD_EQUIPMENT_SINCE=2025-01-01

# ---------------------------------------------------------------------------
# Só desenvolvimento: guarda o resultado das consultas em disco e reaproveita
# no próximo boot por até uma hora (evita reler ~1,7 mi de linhas do ERP a cada
# reinício). Ignorado em produção.
# ---------------------------------------------------------------------------
# relativo à pasta server/ (é de lá que o servidor roda)
# DEV_SOURCE_CACHE_DIR=.source-cache
