		sourceColumn: UNIDADE DE MEDIDA

		annotation SummarizationSetBy = Automatic

	column BASE2 = ```
			
			IF(
			    'DASH_ATUAL_CONSUMOS'[CIDADE] = "São Leopoldo" ||
			    'DASH_ATUAL_CONSUMOS'[CIDADE] = "Sapucaia do Sul" ||
			    'DASH_ATUAL_CONSUMOS'[CIDADE] = "Novo Hamburgo",
			    "Base: SÃO LEO/SPS/NHO",
			    IF(
			        'DASH_ATUAL_CONSUMOS'[CIDADE] = "Esteio" ||
			        'DASH_ATUAL_CONSUMOS'[CIDADE] = "Canoas" ||
			        'DASH_ATUAL_CONSUMOS'[CIDADE] = "Porto Alegre",
			        "Base: EIO/CANOAS/POA",
			        "Base: OUTROS"
			    )
			)
			
			```
		lineageTag: bf50fd66-50c1-4f0d-88a4-215b590ecda6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column QUANTIDADEE
		dataType: int64
		formatString: #,0
		lineageTag: 91e85e45-c59a-44d6-b147-f25d9b271e17
		summarizeBy: sum
		sourceColumn: QUANTIDADEE

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column VALOR
		dataType: double
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d619ee10-f769-4226-8483-5f0b09b272d6
		summarizeBy: sum
		sourceColumn: VALOR

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	partition DASH_ATUAL_CONSUMOS = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select distinct#(lf)#(tab)p.name ""TECNICO"",#(lf)#(tab)P.city ""CIDADE"",#(lf)#(tab)sp.code ""CODIGO"",#(lf)#(tab)sp.title ""DESCRICAO"",#(lf)#(tab)vimp.actual_balance ""QUANTIDADE"",#(lf)#(tab)um.title ""UNIDADE DE MEDIDA"",#(lf)#(tab)ppm.unit_amount ""VALOR"",#(lf)#(tab)ppm.id#(lf)#(tab)from v_internal_movimentations_products vimp#(lf)#(tab)left join service_products sp on sp.id = vimp.service_product_id#(lf)#(tab)left join people p on p.id = vimp.person_id#(lf)#(tab)left join person_product_movimentations ppm on ppm.id = vimp.person_product_movimentation_id#(lf)#(tab)left join units_measures um on um.id = vimp.first_units_measure_id#(lf)#(tab)--where (sp.code like '01425' or sp.code like '00050')#(lf)#(tab)--where sp.code like '00050'#(lf)#(tab)where vimp.actual_balance <> '0'"),
				    #"Linhas Classificadas" = Table.Sort(Fonte,{{"CODIGO", Order.Ascending}}),
				    #"Linhas Agrupadas" = Table.Group(#"Linhas Classificadas", {"TECNICO", "CIDADE", "CODIGO", "DESCRICAO", "UNIDADE DE MEDIDA", "VALOR"}, {{"QUANTIDADEE", each List.Sum([QUANTIDADE]), type nullable number}})
				in
				    #"Linhas Agrupadas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

