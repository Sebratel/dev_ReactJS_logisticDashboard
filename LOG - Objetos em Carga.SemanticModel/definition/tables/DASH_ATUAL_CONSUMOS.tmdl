table DASH_ATUAL_CONSUMOS
	lineageTag: c2a59177-c8e1-4cfd-9a05-64033eb134dd

	measure 'ROTULO PERSONALIZADO2' = ```
			
			    VAR QuantidadeTotal = DISTINCTCOUNT(DASH_ATUAL_CONSUMOS[CODIGO])
			    VAR ValorTotal = SUM(DASH_ATUAL_CONSUMOS[VALOR])
			    
			    RETURN
			        "" & FORMAT(QuantidadeTotal, "#,##0") & 
			        " || R$ " & FORMAT(ValorTotal, "#,##0.00")
			
			```
		lineageTag: eb48217a-5598-4266-9175-d483612373c3

	column TECNICO
		dataType: string
		lineageTag: 0b0ec328-b05a-4690-8ffd-eb57c7a7e04c
