	column BASE = ```
			
			IF(
			    'DASH_ATUAL_TECNICOS'[CIDADE] = "São Leopoldo" ||
			    'DASH_ATUAL_TECNICOS'[CIDADE] = "Sapucaia do Sul" ||
			    'DASH_ATUAL_TECNICOS'[CIDADE] = "Novo Hamburgo",
			    "OUTROS",
			    IF(
			        'DASH_ATUAL_TECNICOS'[CIDADE] = "Esteio" ||
			        'DASH_ATUAL_TECNICOS'[CIDADE] = "Canoas" ||
			        'DASH_ATUAL_TECNICOS'[CIDADE] = "Porto Alegre",
			        "OUTROS",
