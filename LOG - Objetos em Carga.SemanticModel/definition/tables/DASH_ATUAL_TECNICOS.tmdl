	column 'TEMPO (DIAS)' =
			
			DATEDIFF(
			    'DASH_ATUAL_TECNICOS'[DATA DA MOVIMENTACAO],
			    TODAY(),
			    DAY
			)
		formatString: 0
		lineageTag: 13fcc9b8-cea3-4e4d-9fbb-4d0309af5b02
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DASH_ATUAL_TECNICOS = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select #(lf)#(tab)p.code ""CODIGO DO PRODUTO"",#(lf)#(tab)p.title ""DESCRICAO"",#(lf)#(tab)p.serial_number ""SERIAL"",#(lf)#(tab)p.tag_number ""PATRIMONIO"",#(lf)#(tab)p.purchase_amount ""VALOR DO ITEM"",#(lf)#(tab)p2.name ""TECNICO"",#(lf)#(tab)p.modified ""DATA DA MOVIMENTACAO"",#(lf)#(tab)p2.city ""CIDADE"",#(lf)#(tab)sp.code ""CODIGO SERVICO"",#(lf)#(tab)ini.mean_amount ""VALOR MEDIO""#(lf)#(tab)from patrimonies p#(lf)#(tab)left join people p2 on p2.id = p.person_id#(lf)#(tab)left join v_users vu on vu.id = p2.user_id#(lf)#(tab)left join service_products sp on sp.id = p.service_product_id#(lf)#(tab)left join invoice_note_items ini on ini.invoice_note_id = p.entry_invoice_note_id#(lf)#(tab)where p2.name is not null")
				in
				    Fonte

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

