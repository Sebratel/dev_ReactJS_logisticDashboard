table DASH_ATUAL_TECNICOS
	lineageTag: 5f0bc9c3-4c9a-4292-a8d0-228c7d357b99

	measure TOTAL_VALOR = SUM(DASH_ATUAL_TECNICOS[VALOR DO ITEM])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: dd1c60a4-11cf-4dfc-b7c0-a082ad905d4d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'ROTULO PERSONALIZADO' = ```
			
			    VAR QuantidadeTotal = DISTINCTCOUNT(DASH_ATUAL_TECNICOS[PATRIMONIO])
			    VAR ValorTotal = SUM(DASH_ATUAL_TECNICOS[VALOR DO ITEM])
			    
			    RETURN
			        "" & FORMAT(QuantidadeTotal, "#,##0") & 
			        " || R$ " & FORMAT(ValorTotal, "#,##0.00")
			
			```
		lineageTag: 11a78f8a-7a60-4384-9a14-beda389a673b

