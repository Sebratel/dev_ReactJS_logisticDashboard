	partition 'ÚLTIMO VÍNCULO' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "#(lf)WITH CTE AS (#(lf)    SELECT #(lf)        po.patrimony_id AS ""ID"",#(lf)        po.created AS ""DATA"",#(lf)        po.description AS ""DESCRIÇÃO OCORRÊNCIA"",#(lf)        p.title AS ""DESCRIÇÃO PATRIMÔNIO"",#(lf)        LAG(po.description) OVER (PARTITION BY po.patrimony_id ORDER BY po.created ASC) AS ""DESCRIÇÃO_ANTERIOR""#(lf)    FROM #(lf)        patrimony_occurrences po #(lf)    LEFT JOIN #(lf)        patrimonies p #(lf)    ON #(lf)        po.patrimony_id = p.id #(lf)    WHERE #(lf)        p.title IN (#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0 P0625',#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE947',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V1.1 - RE907',#(lf)            'ONU GPON WIFI ZTE F680 AC2000 6 ANTENAS V6.0 - RE913',#(lf)            'ONU GPON WIFI 6 ZTE F6600 AX1800 4 ANTENAS V1.0 - RE963',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE3023'#(lf)        ))#(lf)SELECT #(lf)    ""ID"", #(lf)    ""DATA"", #(lf)    ""DESCRIÇÃO OCORRÊNCIA"", #(lf)    ""DESCRIÇÃO PATRIMÔNIO""#(lf)FROM #(lf)    CTE#(lf)WHERE #(lf)    ""DESCRIÇÃO OCORRÊNCIA"" LIKE '%A.ALMOXARIFADO%'#(lf)    AND EXISTS (#(lf)        SELECT 1 #(lf)        FROM CTE AS prev_cte#(lf)        WHERE #(lf)            prev_cte.""ID"" = CTE.""ID""#(lf)            AND (prev_cte.""DESCRIÇÃO OCORRÊNCIA"" LIKE '%CANCELAMENTO / LABORATÓRIO%'#(lf)                 OR prev_cte.""DESCRIÇÃO OCORRÊNCIA"" LIKE '%MANUTENÇÃO / LABORATÓRIO%')#(lf)            AND prev_cte.""DATA"" < CTE.""DATA""#(lf)    )#(lf)ORDER BY #(lf)    ""ID"", ""DATA"" ASC;"),
				    #"Chave Adicionada" = Table.AddColumn(Fonte, "ChavePersonalizar", each Text.From([ID]) & "_" & Text.From(DateTime.ToText([DATA], "yyyyMMddHHmmss"))),
				    #"Data Extraída" = Table.TransformColumns(#"Chave Adicionada", {{"DATA", DateTime.Date, type date}})
				in
				    #"Data Extraída"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

