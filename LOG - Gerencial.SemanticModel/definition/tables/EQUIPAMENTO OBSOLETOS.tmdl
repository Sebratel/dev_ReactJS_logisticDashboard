table 'EQUIPAMENTO OBSOLETOS'
	lineageTag: 4bd8dfaf-843f-483f-a3c5-e9f1d5167d8e

	measure AcumuladoSeriaisAteMesSelecionado = ```
			
			VAR DataMaxima = MAX('Calendario'[date])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('EQUIPAMENTO OBSOLETOS'[serial_number]),
			        FILTER(
			            ALL('Calendario'),
			            'Calendario'[date] <= DataMaxima
			        )
			    )
			
			```
		formatString: 0
		lineageTag: 8548507d-bec2-478f-9a6a-ee43957a16bb

