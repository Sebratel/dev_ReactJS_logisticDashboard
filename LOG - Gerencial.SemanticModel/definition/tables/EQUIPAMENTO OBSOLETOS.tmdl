	partition 'EQUIPAMENTO OBSOLETOS' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "#(tab)select distinct#(lf)#(tab)p.code,#(lf)#(tab)p.title ""patrimony_description"",#(lf)#(tab)p.serial_number,#(lf)#(tab)p.tag_number,#(lf)#(tab)p.purchase_amount,#(lf)#(tab)p2.name ""thecnical"",#(lf)#(tab)p.modified ""movimentation_date"",#(lf)#(tab)p2.city,#(lf)#(tab)sp.code#(lf)#(tab)from patrimonies p#(lf)#(tab)left join people p2 on p2.id = p.person_id#(lf)#(tab)left join v_users vu on vu.id = p2.user_id#(lf)#(tab)left join service_products sp on sp.id = p.service_product_id#(lf)#(tab)left join invoice_note_items ini on ini.invoice_note_id = p.entry_invoice_note_id#(lf)#(tab)WHERE p2.name LIKE 'A. RADIO / DEPOSITO'"),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"movimentation_date", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

