table Z_MEDIDAS_VALOR
	lineageTag: b45f7621-1171-4828-81f6-c991f8309456

	measure MaM_Valor = ```
			
			DIVIDE(
			    CALCULATE(
			        [Valor_Almoxarifado],
			        Calendario[MES_ATUAL_ANTERIOR] = 1
			    ),
			    CALCULATE(
			        [Valor_Almoxarifado],
			        Calendario[MES_ATUAL_ANTERIOR] = 2
			    )
			) - 1
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 83a355ef-99bd-4370-b57a-cd13ef9c06be

	measure MAaMA_Valor = ```
			
			DIVIDE(
			    CALCULATE(
			        [Valor_Almoxarifado],
			        Calendario[MES_ATUAL_ANTERIOR_ANO] = 1
			    ),
