	measure AaA_Valor = ```
			
			VAR ValorAnoAtual =
			    CALCULATE([Valor_Almoxarifado], Calendario[Ano] = 2026)
			VAR ValorAnoAnterior =
			    CALCULATE([Valor_Almoxarifado], Calendario[Ano] = 2025)
			RETURN
			DIVIDE(ValorAnoAtual, ValorAnoAnterior) - 1
			
			```
