	partition Notas_Fiscais = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select#(lf)#(tab)ini.description as ""Descrição"",#(lf)#(tab)ini.units as ""Quantidade"",#(lf)#(tab)um.title as ""Medida"",#(lf)#(tab)p.name,#(lf)#(tab)ini.created as ""Data criado"",#(lf)#(tab)ini.total_amount,#(lf)#(tab)ini.unit_amount,#(lf)#(tab)ini.service_product_id,#(lf)#(tab)ini.ncm,#(lf)#(tab)in2.client_name_2,#(lf)#(tab)is2.title,#(lf)#(tab)in2.document_number,#(lf)#(tab)in2.total_amount_liquid,#(lf)#(tab)ini.discount,#(lf)#(tab)ini.liquid_amount,#(lf)#(tab)ini.ipi_amount,#(lf)#(tab)ini.icms,#(lf)#(tab)ini.base_icms,#(lf)#(tab)ini.aliquot_icms,#(lf)#(tab)in2.base_icms_substitution ""BC ICSM"",  --BC#(lf)#(tab)in2.base_icms_substitution_amount ""VALOR "", --VLR#(lf)#(tab)spg.title grupoItem#(lf)#(tab)from invoice_note_items ini#(lf)#(tab)left join units_measures um on um.id = ini.first_units_measure_id#(lf)#(tab)left join invoice_notes in2 on in2.id = ini.invoice_note_id#(lf)#(tab)left join invoice_series is2 on is2.id = in2.invoice_serie_id#(lf)#(tab)left join people p on p.id = in2.supplier_id#(lf)#(tab)left join service_products sp on sp.id=ini.service_product_id#(lf)#(tab)left join service_product_groups spg on spg.id=sp.service_product_group_id#(lf)#(tab)--where description like 'CABO DE FIBRA DROP FLATH 1FO'#(lf)#(tab)where ini.created >= '2024-01-01'#(lf)#(tab)and ini.description is not null#(lf)#(tab)and um.title != 'Serviço'#(lf)#(tab)and ini.retain_tax_irrf is true"),
				    #"Colunas Renomeadas" = Table.RenameColumns(Fonte,{{"Descrição", "PRODUTO"}, {"Quantidade", "QUANTIDADE"}, {"Medida", "MEDIDA"}, {"name", "FORNECEDOR"}, {"Data criado", "ENTRADA"}, {"total_amount", "VALOR TOTAL"}, {"ncm", "NCM"}, {"client_name_2", "CLIENTE NOME"}, {"title", "TITULO"}, {"document_number", "N°DOCUMENTO"}, {"total_amount_liquid", "TOTAL LIQUIDO"}, {"service_product_id", "SERVICE_PRODUTO_ID"}, {"discount", "DESCONTOS"}, {"liquid_amount", "VALOR NOTA FISCAL"}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Colunas Renomeadas",{{"N°DOCUMENTO", Int64.Type}, {"TOTAL LIQUIDO", Currency.Type}, {"DESCONTOS", Currency.Type}, {"VALOR NOTA FISCAL", Currency.Type}}),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Tipo Alterado",{{"unit_amount", "VALOR UNITARIO"}, {"ipi_amount", "TOTA IPI"}}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Colunas Renomeadas1",{{"TOTA IPI", Currency.Type}}),
				    #"Colunas Renomeadas2" = Table.RenameColumns(#"Tipo Alterado1",{{"SERVICE_PRODUTO_ID", "ID_PRODUTO"}, {"icms", "ICMS"}, {"base_icms", "BASE_ICMS"}}),
				    #"Colunas Renomeadas3" = Table.RenameColumns(#"Colunas Renomeadas2",{{"aliquot_icms", "ALIQUOT ICMS"}}),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Colunas Renomeadas3",{{"VALOR ", Currency.Type}, {"BC ICSM", Currency.Type}}),
