		sourceColumn: NOME_TÉCNICO

		annotation SummarizationSetBy = Automatic

	partition 'PRIMEIRO VÍNCULO' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "#(lf)#(tab)WITH CTE AS (#(lf)    SELECT #(lf)        p.id AS ""ID"",#(lf)        po.title AS ""TIPO"",#(lf)        po.created AS ""DATA"",#(lf)        p.title AS ""PATRIMÔNIO DESCRIÇÃO"",#(lf)        po.description AS ""DESCRIÇÃO MOVIMENTAÇÃO"",#(lf)        ROW_NUMBER() OVER (PARTITION BY p.id ORDER BY po.created ASC) AS rn,#(lf)        TRIM(SUBSTRING(po.description FROM POSITION('Sob Responsabilidade de ' IN po.description) + LENGTH('Sob Responsabilidade de '))) AS ""NOME_TÉCNICO""#(lf)    FROM #(lf)        patrimony_occurrences po#(lf)    LEFT JOIN #(lf)        patrimonies p #(lf)    ON #(lf)        p.id = po.patrimony_id#(lf)    WHERE #(lf)        po.title = 'Enviado em Romaneio'#(lf)        and p.title in (#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0 P0625',#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE947',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V1.1 - RE907',#(lf)            'ONU GPON WIFI ZTE F680 AC2000 6 ANTENAS V6.0 - RE913',#(lf)            'ONU GPON WIFI 6 ZTE F6600 AX1800 4 ANTENAS V1.0 - RE963',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE3023'#(lf)))#(lf)SELECT #(lf)    ""ID"", #(lf)    ""TIPO"", #(lf)    ""DATA"", #(lf)    ""PATRIMÔNIO DESCRIÇÃO"", #(lf)    ""DESCRIÇÃO MOVIMENTAÇÃO"", #(lf)    ""NOME_TÉCNICO""#(lf)FROM #(lf)    CTE#(lf)WHERE #(lf)    rn = 1;#(lf)#(lf)#(tab)#(tab)#(lf)"),
				    #"Data Extraída" = Table.TransformColumns(Fonte,{{"DATA", DateTime.Date, type date}})
				in
				    #"Data Extraída"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

