table QuantidadeRomaneios
	lineageTag: 8b8c4d21-cd47-4194-8654-530cbceb7bfb

	measure 'Qtd Romaneios' = ```
			COUNT(QuantidadeRomaneios[ID])
			
			```
		formatString: 0
		lineageTag: 769bae22-92cf-4634-95d5-22cb4cb40da1

	measure 'Variação % Mês (sem mês atual)' = ```
			
			VAR MesAtual = MAX(QuantidadeRomaneios[DATA])
			VAR UltimoMesCompleto =
			    EOMONTH(TODAY(), -1)
			VAR RomaneiosAtual =
			    CALCULATE(
			        [Qtd Romaneios],
			        FILTER(
			            ALL(QuantidadeRomaneios[DATA]),
			            EOMONTH(QuantidadeRomaneios[DATA], 0) = UltimoMesCompleto
			        )
			    )
			VAR RomaneiosAnterior =
			    CALCULATE(
			        [Qtd Romaneios],
			        FILTER(
			            ALL(QuantidadeRomaneios[DATA]),
			            EOMONTH(QuantidadeRomaneios[DATA], 0) = EOMONTH(UltimoMesCompleto, -1)
			        )
			    )
			RETURN
			DIVIDE(RomaneiosAtual - RomaneiosAnterior, RomaneiosAnterior)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 766a5727-64dc-4c92-b2f2-a3611ff25928

	measure 'Média Romaneios por Pessoa (Últimos 2 meses)' = ```
			
			VAR UltimoMesCompleto = EOMONTH(TODAY(), -1)
			VAR PenultimoMesCompleto = EOMONTH(TODAY(), -2)
			
			VAR MediaPenultimoMes =
			    AVERAGEX(
			        VALUES(QuantidadeRomaneios[NOME]),
			        CALCULATE(
			            COUNT(QuantidadeRomaneios[ID]),
			            FILTER(
			                QuantidadeRomaneios,
			                EOMONTH(QuantidadeRomaneios[DATA], 0) = PenultimoMesCompleto
			            )
			        )
			    )
			
			VAR MediaUltimoMes =
			    AVERAGEX(
			        VALUES(QuantidadeRomaneios[NOME]),
			        CALCULATE(
			            COUNT(QuantidadeRomaneios[ID]),
			            FILTER(
			                QuantidadeRomaneios,
			                EOMONTH(QuantidadeRomaneios[DATA], 0) = UltimoMesCompleto
			            )
			        )
			    )
			
			RETURN
			DIVIDE(MediaPenultimoMes + MediaUltimoMes, 2)
			
			
			```
		lineageTag: 14a2ee13-5fce-4011-bb89-652374bde566

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação % Mês (Notas Distintas)' = ```
			
			VAR UltimoMesCompleto =
			    EOMONTH(TODAY(), -1)
			VAR RomaneiosAtual =
			    CALCULATE(
			        DISTINCTCOUNT(QuantidadeRomaneios[DESCRIÇÃO]),
			        FILTER(
			            ALL(QuantidadeRomaneios[DATA]),
			            EOMONTH(QuantidadeRomaneios[DATA], 0) = UltimoMesCompleto
			        )
			    )
			VAR RomaneiosAnterior =
			    CALCULATE(
			        DISTINCTCOUNT(QuantidadeRomaneios[DESCRIÇÃO]),
			        FILTER(
			            ALL(QuantidadeRomaneios[DATA]),
			            EOMONTH(QuantidadeRomaneios[DATA], 0) = EOMONTH(UltimoMesCompleto, -1)
			        )
			    )
			RETURN
			DIVIDE(RomaneiosAtual - RomaneiosAnterior, RomaneiosAnterior)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d66ee2c2-f9f5-40df-91e7-249a15617c22

	measure 'Média Romaneios Distintos por Pessoa (Últimos 2 meses)' = ```
			
			VAR UltimoMesCompleto = EOMONTH(TODAY(), -1)
			VAR PenultimoMesCompleto = EOMONTH(TODAY(), -2)
			
			VAR MediaPenultimoMes =
			    AVERAGEX(
			        VALUES(QuantidadeRomaneios[NOME]),
			        CALCULATE(
			            DISTINCTCOUNT(QuantidadeRomaneios[DESCRIÇÃO]),
			            KEEPFILTERS(
			                FILTER(
			                    QuantidadeRomaneios,
			                    EOMONTH(QuantidadeRomaneios[DATA], 0) = PenultimoMesCompleto
			                )
			            )
			        )
			    )
			
			VAR MediaUltimoMes =
			    AVERAGEX(
			        VALUES(QuantidadeRomaneios[NOME]),
			        CALCULATE(
			            DISTINCTCOUNT(QuantidadeRomaneios[DESCRIÇÃO]),
			            KEEPFILTERS(
			                FILTER(
			                    QuantidadeRomaneios,
			                    EOMONTH(QuantidadeRomaneios[DATA], 0) = UltimoMesCompleto
			                )
			            )
			        )
			    )
			
			RETURN
			DIVIDE(MediaPenultimoMes + MediaUltimoMes, 2)
			
			
			```
		formatString: 0
		lineageTag: ea4faa39-d529-498a-943e-2f6a3282443d

		annotation PBI_FormatHint = {"isDecimal":true}

