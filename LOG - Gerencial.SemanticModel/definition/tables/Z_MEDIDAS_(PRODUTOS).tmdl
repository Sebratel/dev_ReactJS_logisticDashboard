table Z_MEDIDAS_(PRODUTOS)
	lineageTag: 45b4549b-39aa-4cdf-9710-45060e9c4598

	measure MaM_Produto = ```
			
			DIVIDE(
			    CALCULATE(
			        [Qtd_produto],
			        Calendario[MES_ATUAL_ANTERIOR] = 1
			    ),
			    CALCULATE(
			        [Qtd_produto],
			        Calendario[MES_ATUAL_ANTERIOR] = 2
			    )
			) - 1
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b7cbd824-619d-4d0b-a79d-30d8f388a32a

	measure TaT_Produto = ```
			
			DIVIDE(
			    CALCULATE(
