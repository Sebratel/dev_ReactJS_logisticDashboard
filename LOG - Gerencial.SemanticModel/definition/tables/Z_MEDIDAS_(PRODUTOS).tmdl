			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 516478c5-8b72-4b4b-ab5a-d43a83e25dd8

	measure AaA_Produto = ```
			
			VAR ValorAnoAtual =
			    CALCULATE([Qtd_produto], Calendario[Ano] = 2026)
			VAR ValorAnoAnterior =
			    CALCULATE([Qtd_produto], Calendario[Ano] = 2025)
			RETURN
			DIVIDE(ValorAnoAtual, ValorAnoAnterior) - 1
			
			```
		formatString: 0.00%;-0.00%;0.00%
