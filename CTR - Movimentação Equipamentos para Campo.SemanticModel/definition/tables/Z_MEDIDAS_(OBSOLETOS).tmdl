table Z_MEDIDAS_(OBSOLETOS)
	lineageTag: a16ebbea-bf2e-4002-96f0-43457d2596b0

	measure AaA_Obsoletos = ```
			
			VAR ValorAnoAtual = 
			    CALCULATE(
			        [AcumuladoSeriaisAteMesSelecionado],
			        FILTER(
			            ALL('Calendario'),
			            Calendario[ANO_ATUAL_ANTERIOR] = 1
			        )
			    )
			
			VAR ValorAnoAnterior = 
			    CALCULATE(
			        [AcumuladoSeriaisAteMesSelecionado],
			        FILTER(
			            ALL('Calendario'),
			            Calendario[ANO_ATUAL_ANTERIOR] = 2
			        )
			    )
			
			RETURN
			    DIVIDE(ValorAnoAtual, ValorAnoAnterior, 0) - 1
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0399cdce-a228-4403-835d-2b7e8cc8959c

