	partition 'ÚLTIMO VÍNCULO' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbvoalle", "WITH CTE AS (#(lf)    SELECT #(lf)        po.patrimony_id AS ""ID"",#(lf)        po.created AS ""DATA"",#(lf)        po.description AS ""DESCRIÇÃO OCORRÊNCIA"",#(lf)        p.title AS ""DESCRIÇÃO PATRIMÔNIO"",#(lf)        LAG(po.description) OVER (PARTITION BY po.patrimony_id ORDER BY po.created ASC) AS ""DESCRIÇÃO_ANTERIOR""#(lf)    FROM #(lf)        patrimony_occurrences po #(lf)    LEFT JOIN #(lf)        patrimonies p #(lf)    ON #(lf)        po.patrimony_id = p.id #(lf)    WHERE #(lf)          p.title IN (#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V1.1 - RE907',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE947',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE3023',#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0 P0625',#(lf)            'ROTEADOR WIFI 6 ZTE MESH AX3000 H3601PE 5 ANTENAS',#(lf)            'ROTEADOR WIFI ZTE PRO MESH AC1200 H198A 2 ANTENAS - RE914',#(lf)            'ROTEADOR WIFI ZTE PRO MESH AC1200 H199A 4 ANTENAS - RE942',#(lf)            'ONU GPON WIFI ZTE F680 AC2000 6 ANTENAS V6.0 - RE913',#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0'#(lf))#(lf)        AND p.title NOT IN (#(lf)            'ONU FIBERHOME GPON AN5506-02-BG(B) - 1GE + 1FE + 1POT',#(lf)            'ANTENA AIRGRID M2 20 DBI',#(lf)            'ANTENA AP ADAP WI-FI 5GHZ C/ANT 27DBI - AIR GRID M5-HP',#(lf)            'ANTENA AP ADAP. WI-FI 5GHZ C/ANT. 23DBI-AIR GRID M5 HP',#(lf)            'ANTENA UBIQUITI NANOBRIDGE 900MHZ',#(lf)            'ARCHER C2 ROTEADOR WIRELESS GIGABIT DUAL BAND AC 750 2 ANTENAS',#(lf)            'F. ONU EPON FD600-111G 1GE MINI PON PORT 10/100/1000',#(lf)            'F. ONU EPON V2801ZE 01 PORT GE PPPOE/BRIDGE OEM',#(lf)            'F. ONU GPON WIFI HUAWEI EG8141A5 ECHOLIFE (N2-BR)',#(lf)            'F. ONU GPON WIFI HUAWEI EG8145V5 ECHOLIFE',#(lf)            'F. ONU GPON WIFI HUAWEI EG8145V5 ECHOLIFE (AC2)',#(lf)            'F. ONU GPON WIFI HUAWEI EG8145V5 ECHOLIFE (AC2-BR)',#(lf)            'F. ONU GPON WIFI HUAWEI HG8546M ECHOLIFE',#(lf)            'F. ONU GPON WIFI HUAWEI HG8546M ECHOLIFE (N)',#(lf)            'F. ONU GPON WIFI HUAWEI HS8545M5 NOVO 1GE+3FE+1POT+1USB',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546M ECHOLIFE',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546M5 ECHOLIFE',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE (AC)',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE (AC-1PG)',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE (AC2-BR)',#(lf)            'F. ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE (AC3)',#(lf)            'FIBERLINK 100',#(lf)            'NANO LOCO',#(lf)            'NANO M5 LOCO',#(lf)            'ONU FIBERHOME GPON AN 5506-04-FG + WIFI',#(lf)            'ONU FIBERHOME GPON AN5506-01-A B - 1 GE',#(lf)            'ONU FIBERHOME GPON AN5506-02-B - C/ (TELEFONIA)',#(lf)            'ONU FIBERHOME GPON AN5506-02-B (TELEFONIA)',#(lf)            'ONU FIBERHOME GPON AN5506-02-BG(B) - 1GE + 1FE + 1POT',#(lf)            'ONU FIBERHOME GPON AN5506-04-FG-4GE+2POTS+WIFI',#(lf)            'ONU GPON BRIDGE PARKS FIBERLINK 100',#(lf)            'ONU GPON BRIDGE ZTE F601V7.0 (05)',#(lf)            'ONU GPON PARKS FIBERLINK 101',#(lf)            'ONU GPON WIFI 6 ZTE F6600 AX1800 4 ANTENAS V1.0 - RE963',#(lf)            'ONU GPON WIFI AC1200 F670L V9.0',#(lf)            'Onu Gpon Wifi Ac1200 F670L V9.0',#(lf)            'ONU GPON WIFI HUAWEI EG8145V5 ECHOLIFE (AC4-BR)',#(lf)            'ONU GPON WIFI HUAWEI EG8145V5 ECHOLIFE AC 2 ANTENAS (Versão AC2)',#(lf)            'ONU GPON WIFI HUAWEI EG8145V5 ECHOLIFE AC 2 ANTENAS (Versão AC2-BR)',#(lf)            'ONU GPON WIFI HUAWEI HG8546M N300 2 ANTENAS',#(lf)            'ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE AC 2 ANTENAS',#(lf)            'ONU GPON WIFI HUAWEI HS8546V5 ECHOLIFE AC 2 ANTENAS - MODELO ""AC3""',#(lf)        