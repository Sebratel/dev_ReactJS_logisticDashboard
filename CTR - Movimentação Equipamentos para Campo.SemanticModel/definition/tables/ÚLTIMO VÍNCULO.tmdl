NK EC230-G1 DUAL BAND AC 1350 (PRESET)',#(lf)            'ROTEADOR WRN 240 SLIM N150MBPS INTELBRAS',#(lf)            'TL-WR720N ROTEADOR WIRELESS N 150 MBPS',#(lf)            'TL-WR820N ROTEADOR WIRELESS N 300 MBPS',#(lf)            'TL-WR829(BR) ROTEADOR WIRELESS N 300 MBPS',#(lf)            'UBIQUITI AIRMAX NANOSTATION LOCOM2 BR',#(lf)            'UBIQUITI POWERBEAM AIRMAX NBE-M5-300 5GHZ 22DBI DUPLA POLARIDADE',#(lf)            'UBIQUITI POWERBEAM NBE-M5-400 5GHZ 25DBI DUPLA POLARIZ.'#(lf)        )#(lf))#(lf)#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)SELECT #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    ""ID"", #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    ""DATA"", #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    ""DESCRIÇÃO OCORRÊNCIA"",#(lf)                                             ""DESCRIÇÃO PATRIMÔNIO""#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)FROM #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    CTE#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)WHERE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    ""DESCRIÇÃO OCORRÊNCIA"" LIKE '%A.ALMOXARIFADO%'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    AND EXISTS (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)        SELECT 1 #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)        FROM CTE AS prev_cte#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)        WHERE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)            prev_cte.""ID"" = CTE.""ID""#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)            AND (prev_cte.""DESCRIÇÃO OCORRÊNCIA"" LIKE '%CANCELAMENTO / LABORATÓRIO%'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)                 OR prev_cte.""DESCRIÇÃO OCORRÊNCIA"" LIKE '%MANUTENÇÃO / LABORATÓRIO%')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)            AND prev_cte.""DATA"" < CTE.""DATA""#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    )#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)ORDER BY #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)    ""ID"", ""DATA"" ASC;"),
