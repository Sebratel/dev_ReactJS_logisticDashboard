	partition 'PRIMEIRO VÍNCULO' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbvoalle", "WITH CTE AS (#(lf)    SELECT #(lf)        p.id AS ""ID"",#(lf)        po.title AS ""TIPO"",#(lf)        po.created AS ""DATA"",#(lf)        p.title AS ""PATRIMÔNIO DESCRIÇÃO"",#(lf)        po.description AS ""DESCRIÇÃO MOVIMENTAÇÃO"",#(lf)        ROW_NUMBER() OVER (PARTITION BY p.id ORDER BY po.created ASC) AS rn,#(lf)        TRIM(SUBSTRING(po.description FROM POSITION('Sob Responsabilidade de ' IN po.description) + LENGTH('Sob Responsabilidade de '))) AS ""NOME_TÉCNICO""#(lf)    FROM #(lf)        patrimony_occurrences po#(lf)    LEFT JOIN #(lf)        patrimonies p #(lf)        ON p.id = po.patrimony_id#(lf)    WHERE #(lf)        po.title = 'Enviado em Romaneio'#(lf)        AND p.title IN (#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V1.1 - RE907',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE947',#(lf)            'ONU GPON WIFI ZTE F670L AC1200 2 ANTENAS V9.0 - RE3023',#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0 P0625',#(lf)            'ROTEADOR WIFI 6 ZTE MESH AX3000 H3601PE 5 ANTENAS',#(lf)            'ROTEADOR WIFI ZTE PRO MESH AC1200 H198A 2 ANTENAS - RE914',#(lf)            'ROTEADOR WIFI ZTE PRO MESH AC1200 H199A 4 ANTENAS - RE942',#(lf)            'ONU GPON WIFI ZTE F680 AC2000 6 ANTENAS V6.0 - RE913',#(lf)            'ONU GPON WIFI 6 ZTE F6600P AX3000 4 ANTENAS V9.0'#(lf)        )#(lf)        AND p.title NOT IN (#(lf)            'ONU FIBERHOME GPON AN5506-02-BG(B) - 1GE + 1FE + 1POT',#(lf)            'ANTENA AIRGRID M2 20 DBI',#(lf)            'ANTENA AP ADAP WI-FI 5GHZ C/ANT 27DBI - AIR GRID M5-HP',#(lf)            'ANTENA AP ADAP. WI-FI 5GHZ C/ANT. 23DBI-AIR GRID M5 HP',#(lf)            'ANTENA UBIQUITI NANOBRIDGE 900MHZ',#(lf)            'ARCHER C2 ROTEADOR WIRELESS GIGABIT DUAL BAND AC 750 2 ANTENAS',#(lf)            'F. ONU EPON FD600-111G 1GE MINI PON PORT 10/100/1000',#(lf)            'F. ONU EPON V2801ZE 01 PORT GE PPPOE/BRIDGE OEM',#(lf)         