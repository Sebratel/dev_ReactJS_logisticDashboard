EADOR WIRELESS N 300 MBPS TL-WR840N<W>PRESET PROVEDORES TP-LINK',#(lf)            'ROTEADOR WIRELESS N 300 MBPS TL-WR840N<W>PRESET PROVEDORES TP-LINK@',#(lf)            'ROTEADOR WIRELESS TP-LINK EC230-G1 DUAL BAND AC 1350 (PRESET)',#(lf)            'ROTEADOR WRN 240 SLIM N150MBPS INTELBRAS',#(lf)            'TL-WR720N ROTEADOR WIRELESS N 150 MBPS',#(lf)            'TL-WR820N ROTEADOR WIRELESS N 300 MBPS',#(lf)            'TL-WR829(BR) ROTEADOR WIRELESS N 300 MBPS',#(lf)            'UBIQUITI AIRMAX NANOSTATION LOCOM2 BR',#(lf)            'UBIQUITI POWERBEAM AIRMAX NBE-M5-300 5GHZ 22DBI DUPLA POLARIDADE',#(lf)            'UBIQUITI POWERBEAM NBE-M5-400 5GHZ 25DBI DUPLA POLARIZ.'#(lf)        )#(lf))#(lf)SELECT #(lf)    ""ID"", #(lf)    ""TIPO"", #(lf)    ""DATA"", #(lf)    ""PATRIMÔNIO DESCRIÇÃO"", #(lf)    ""DESCRIÇÃO MOVIMENTAÇÃO"", #(lf)    ""NOME_TÉCNICO""#(lf)FROM #(lf)    CTE#(lf)WHERE #(lf)    rn = 1;#(lf)"),
				    #"Data Extraída" = Table.TransformColumns(Fonte,{{"DATA", DateTime.Date, type date}})
				in
				    #"Data Extraída"

	annotation PBI_NavigationStepName = Navegação

