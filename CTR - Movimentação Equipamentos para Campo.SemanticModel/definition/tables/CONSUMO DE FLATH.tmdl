	partition 'CONSUMO DE FLATH' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select distinct #(lf)#(tab)p.name,#(lf)#(tab)p2.name,#(lf)#(tab)ppm.units,#(lf)#(tab)um.symbol, #(lf)#(tab)ppm.created,#(lf)#(tab)sp.code, #(lf)#(tab)sp.title, #(lf)#(tab)ppm.assignment_id, #(lf)#(tab)cpbu.description,#(lf)#(tab)t.title#(lf)#(tab)from person_product_movimentations ppm#(lf)#(tab)left join people p on p.id = ppm.person_id#(lf)#(tab)left join service_products sp on sp.id = ppm.service_product_id #(lf)#(tab)left join units_measures um on um.id = ppm.first_units_measure_id#(lf)#(tab)left join people p2 on p2.id = ppm.created_by#(lf)#(tab)left join company_place_business_units cpbu on cpbu.id = ppm.company_place_business_unit_id#(lf)#(tab)left join people_teams pt on pt.person_id = p.id#(lf)#(tab)left join teams t on t.id = pt.team_id#(lf)#(tab)where ppm.created >= '2022-01-01'#(lf)#(tab)and sp.""type"" = '1'#(lf)        and sp.code like '00069'#(lf)#(tab)and (t.title like 'Técnica [Triunfo]'#(lf)#(tab)#(tab)or t.title like 'Técnica Rádio [NH]'#(lf)#(tab)#(tab)or t.title like 'Técnica [Região Paranhana (PRB / TSC / IGN / TQR)]'#(lf)#(tab)#(tab)or t.title like 'Técnica [Nova Santa Rita]'#(lf)#(tab)#(tab)or t.title like 'Instalação Corporativo'#(lf)#(tab)#(tab)or t.title like 'Instalação [Triunfo]'#(lf)#(tab)#(tab)or t.title like 'Instalação [SLE/SPS/NHO/EIO/CAN]'#(lf)#(tab)#(tab)or t.title like 'Instalação [Região Paranhana (PRB / TSC / IGN / TQR)]'#(lf)#(tab)#(tab)or t.title like 'Instalação [Nova Santa Rita, Esteio]'#(lf)#(tab)#(tab)or t.title like 'Instalação [Erechim / Gaurama / Viadutos ]'#(lf)#(tab)#(tab)or t.title like 'Instalação [Brochier]'#(lf)#(tab)#(tab)or t.title like 'Infraestrutura/Construção de Rede'#(lf)#(tab)#(tab)or t.title like 'Infraestrutura/Backbone'#(lf)#(tab)#(tab)or t.title like 'Infraestrutura Geral'#(lf)#(tab)#(tab)or t.title like 'Infra - Preventiva e Corretiva'#(lf)#(tab)#(tab)or t.title like 'Infra - Execução de Condomínios/Corporativos'#(lf)#(tab)#(tab)or t.title like 'Infra - Ampliação/Manutenção de Splitters'#(lf)#(tab)#(tab)or t.title like 'Equipe de Tecnologia NHO/SLE/SPS'#(lf)#(tab)#(tab)or t.title like 'Equipe de Tecnologia EIO/CAN'#(lf)#(tab)#(tab)or t.title like 'Equipe de Reparo NHO/SLE/SPS'#(lf)#(tab)#(tab)or t.title like 'Equipe de Reparo EIO/CAN')#(lf)#(tab)order by ppm.created desc"),
				    #"Colunas Renomeadas" = Table.RenameColumns(Fonte,{{"name", "RESPONSÁVEL"}, {"units", "QUANTIDADE"}, {"symbol", "UNIDADE"}, {"created", "CRIADO EM"}, {"code", "CODIGO"}, {"title", "PRODUTO"}, {"assignment_id", "TIPO"}}),
