	partition 'OBJETOS CRIADOS' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbvoalle", "select distinct #(lf)#(tab)po.id ""ID"",#(lf)#(tab)po.title ""Tipo"",#(lf)#(tab)po.description ""Descrição"",#(lf)#(tab)po.date ""Data"" ,#(lf)#(tab)p.title ""Patrimonio"",#(lf)#(tab)p.serial_number,#(lf)#(tab)p.p_is_disponible#(lf)#(tab)from patrimony_occurrences po#(lf)#(tab)left join patrimonies p on p.id = po.patrimony_id#(lf)#(tab)where po.title like '%Criação do Objeto%'#(lf)#(tab)and po.date >= '2025-01-01'"),
				    #"Colunas Renomeadas" = Table.RenameColumns(Fonte,{{"p_is_disponible", "STATUS DISPONIVEL"}, {"serial_number", "SERIAL"}, {"Patrimonio", "PATRIMONIO"}, {"Data", "DATA"}, {"Descrição", "DESCRICAO"}, {"Tipo", "TIPO"}})
				in
				    #"Colunas Renomeadas"

	annotation PBI_ResultType = Table

