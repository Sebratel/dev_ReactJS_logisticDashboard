		sourceColumn: Gera Patrimônio

		annotation SummarizationSetBy = Automatic

	partition Produtos = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "SELECT#(lf)    sp.code          AS ""Código"",#(lf)    sp.title         AS ""Item"",#(lf)    cpbu.description AS ""Base"",#(lf)    SUM(v.disponible) AS ""Quantidade"",#(lf)    um.title as ""Unidade"",#(lf)    sp.inventory_update as ""Atualiza Estoque"",#(lf)    sp.generate_patrimony as ""Gera Patrimônio""#(lf)FROM v_company_place_business_units_movimentations v#(lf)LEFT JOIN company_place_business_units cpbu ON cpbu.id = v.company_place_business_unit_id #(lf)LEFT JOIN service_products sp ON sp.id = v.service_product_id #(lf)LEFT JOIN companies_places cp ON cp.id = v.company_place_id #(lf)left join units_measures um  on um.id = sp.first_unit #(lf)WHERE #(lf)    sp.title IS NOT NULL#(lf)    AND cp.id = 1#(lf)    AND cpbu.deleted IS NOT TRUE#(lf)GROUP BY#(lf)    sp.code,#(lf)    sp.title,#(lf)    um.title,#(lf)    cpbu.description,#(lf)    sp.inventory_update,#(lf)    sp.generate_patrimony #(lf)ORDER BY#(lf)    sp.title"),
				    #"Valor Substituído" = Table.ReplaceValue(Fonte,"0","Não",Replacer.ReplaceText,{"Atualiza Estoque"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","1","Sim",Replacer.ReplaceText,{"Atualiza Estoque"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído1","0","Não",Replacer.ReplaceText,{"Gera Patrimônio"}),
				    #"Valor Substituído3" = Table.ReplaceValue(#"Valor Substituído2","1","Sim",Replacer.ReplaceText,{"Gera Patrimônio"})
				in
				    #"Valor Substituído3"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

