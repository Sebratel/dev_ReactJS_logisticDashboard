	partition 'Pedido de Compra' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select#(lf)par.date as ""Data"",#(lf)p2.name as ""Fornecedor"",#(lf)par.id as ""N°"",#(lf)par.total_request as ""Total Pedido"",#(lf)par.receipt_date_prevision as ""Prev.Entrega"",#(lf)par.deleted as ""Deletado"",#(lf)p.name as ""Pessoa"",#(lf)par.status as ""Status"",#(lf)sp.code as ""Código"",#(lf)sp.title as ""Descrição Item"",#(lf)pari.units as ""Qtd."",#(lf)pari.unit_amount as ""Val. Unitário"",#(lf)pari.item_amount as ""Total"",#(lf)pari.total_amount as ""Total com Imposto"",#(lf)um.title as ""Unidade"",#(lf)CASE #(lf)WHEN UPPER(par.observation) LIKE '%SCHARLAU%' THEN 'BASE OPERACIONAL - SÃO LEOPOLDO'#(lf)WHEN UPPER(par.observation) LIKE '%VICTOR BARRETO%' THEN 'BASE OPERACIONAL - CANOAS'#(lf)WHEN UPPER(par.observation) LIKE '%NAVEGANTES%' THEN 'SEDE - PORTO ALEGRE'#(lf)END AS ""BASE"",#(lf)sp.inventory_update as ""Atualiza Estoque"",#(lf)sp.generate_patrimony as ""Gera Patrimônio""#(lf)from product_acquisition_requests par#(lf)left join product_acquisition_request_items pari on pari.product_acquisition_request_id = par.id#(lf)left join service_products sp on sp.id = pari.service_product_id#(lf)left join units_measures um on um.id = sp.first_unit #(lf)left join people p on p.id = par.person_id#(lf)left join people p2 on p2.id = par.supplier_id #(lf)where par.date >= '01-01-2026'#(lf)order by par.id DESC"),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Status", type text}}),
				    #"Valor Substituído" = Table.ReplaceValue(#"Tipo Alterado","1","Inclusão",Replacer.ReplaceText,{"Status"}),
				    #"Valor Substituído3" = Table.ReplaceValue(#"Valor Substituído","2","Cancelado",Replacer.ReplaceText,{"Status"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído3","4","Aguardando Entrega",Replacer.ReplaceText,{"Status"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído1","5","Recebido",Replacer.ReplaceText,{"Status"}),
				    #"Valor Substituído4" = Table.ReplaceValue(#"Valor Substituído2","0","Não",Replacer.ReplaceText,{"Atualiza Estoque"}),
				    #"Valor Substituído5" = Table.ReplaceValue(#"Valor Substituído4","1","Sim",Replacer.ReplaceText,{"Atualiza Estoque"}),
				    #"Valor Substituído6" = Table.ReplaceValue(#"Valor Substituído5","0","Não",Replacer.ReplaceText,{"Gera Patrimônio"}),
				    #"Valor Substituído7" = Table.ReplaceValue(#"Valor Substituído6","1","Sim",Replacer.ReplaceText,{"Gera Patrimônio"}),
				    #"Valor Substituído8" = Table.ReplaceValue(#"Valor Substituído7","0","Não",Replacer.ReplaceText,{"Deletado"}),
				    #"Valor Substituído9" = Table.ReplaceValue(#"Valor Substituído8","1","Deletado",Replacer.ReplaceText,{"Deletado"})
				in
				    #"Valor Substituído9"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

