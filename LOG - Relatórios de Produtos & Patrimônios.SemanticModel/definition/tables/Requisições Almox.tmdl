	partition 'Requisições Almox' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "SELECT DISTINCT #(lf)    ppm.units,#(lf)    sp.code,#(lf)    sp.id,#(lf)    sp.title,#(lf)    cpbu.description,#(lf)    ppm.created,#(lf)    p.name,#(lf)    p2.name,#(lf)    t.title AS ""equipes"",#(lf)    p2.name AS ""responsáveis""#(lf)FROM person_product_movimentations ppm#(lf)LEFT JOIN people p ON p.id = ppm.person_id#(lf)LEFT JOIN service_products sp ON sp.id = ppm.service_product_id #(lf)LEFT JOIN units_measures um ON um.id = ppm.first_units_measure_id#(lf)LEFT JOIN v_users p2 ON p2.id = ppm.created_by#(lf)LEFT JOIN company_place_business_units cpbu ON cpbu.id = ppm.company_place_business_unit_id#(lf)LEFT JOIN people_teams pt ON pt.person_id = p.id#(lf)LEFT JOIN teams t ON t.id = pt.team_id#(lf)WHERE ppm.created >= '2024-01-01'#(lf)  AND sp.""type"" = '1'#(lf)  ---AND sp.code = '00069'#(lf)  AND NOT (#(lf)        DATE(ppm.created) = '2025-09-04'  -- ajusta para o ano correto#(lf)        AND p.name IN (#(lf)            'A.ALMOXARIFADO / SÃO LEO',#(lf)            'A.ALMOXARIFADO / SEDE PORTO ALEGRE',#(lf)            'A.ALMOXARIFADO / CANOAS'#(lf)        )#(lf)  )#(lf)ORDER BY ppm.created DESC;#(lf)"),
				    #"Colunas Renomeadas" = Table.RenameColumns(Fonte,{{"code", "CÓDIGO"}, {"id", "ID"}, {"title", "DESCRIÇÃO"}, {"units", "UNIDADE CONSUMIDA"}, {"description", "BASE DE ORIGEM"}, {"created", "DATA"}}),
				    #"Linhas Classificadas" = Table.Sort(#"Colunas Renomeadas",{{"DATA", Order.Descending}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Linhas Classificadas",{{"DATA", type date}}),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Tipo Alterado",{{"name", "RECEBEDOR"}, {"name2", "FORNECEDOR"}}),
				    #"Linhas Filtradas" = Table.SelectRows(#"Colunas Renomeadas1", each ([RECEBEDOR] = "A.ALMOXARIFADO / CANOAS" or [RECEBEDOR] = "A.ALMOXARIFADO / SEDE PORTO ALEGRE" or [RECEBEDOR] = "A.ALMOXARIFADO / SÃO LEO"))
				in
				    #"Linhas Filtradas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

