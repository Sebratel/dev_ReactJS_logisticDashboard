	partition 'Objetos Pendentes' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select #(lf)t.document_number as ""NOTA FISCAL"",#(lf)ppg.date as ""DATA ENTRADA"",#(lf)sp.code as ""CODIGO"",#(lf)sp.title as ""ITEM"",#(lf)ppg.units as ""TOTAL"",#(lf)ppg.balance as ""PENDENTES"",#(lf)cpbu.description as ""BASE OPERACIONAL"" #(lf)from patrimonies_pending_generations ppg #(lf)left join invoice_notes t on t.id = ppg.invoice_note_id#(lf)left join service_products sp on sp.id = ppg.service_product_id #(lf)left join company_place_business_units cpbu on cpbu.id = ppg.company_place_business_unit_id#(lf)where ppg.balance <> '0'"),
				    #"Linhas Filtradas" = Table.SelectRows(Fonte, each ([PENDENTES] <> -1))
				in
				    #"Linhas Filtradas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

