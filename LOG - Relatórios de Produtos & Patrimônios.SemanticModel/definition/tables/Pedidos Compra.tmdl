	partition 'Pedidos Compra' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "      SELECT #(lf)          par.id,#(lf)          sp.code AS ""CÓDIGO"",#(lf)          sp.title AS ""PRODUTO"",#(lf)          par.date AS ""DATA"",#(lf)          p.name AS ""REQUISITADO POR"",#(lf)          par.receipt_date_prevision AS ""DATA PREVISÃO"",#(lf)          pari.units AS ""TOTAL"",#(lf)          par.observation,#(lf)#(tab)#(tab)#(tab) CASE #(lf)#(tab)#(tab)#(tab)    WHEN UPPER(par.observation) LIKE '%93120%' THEN 'BASE OPERACIONAL - SÃO LEOPOLDO'#(lf)#(tab)#(tab)#(tab)    WHEN UPPER(par.observation) LIKE '%92010%' THEN 'BASE OPERACIONAL - CANOAS'#(lf)#(tab)#(tab)#(tab)    WHEN UPPER(par.observation) LIKE '%90230%' THEN 'SEDE - PORTO ALEGRE'#(lf)#(tab)#(tab)#(tab)    ELSE '' -- Opcional, para lidar com valores que não se encaixam nas condições#(lf)#(tab)#(tab)#(tab)END AS ""BASE"",#(lf)#(tab)      'Aguardando Entrega' AS ""STATUS""#(lf)      FROM product_acquisition_requests par#(lf)      LEFT JOIN product_acquisition_request_items AS pari ON pari.product_acquisition_request_id = par.id#(lf)      LEFT JOIN service_products sp ON sp.id = pari.service_product_id#(lf)      LEFT JOIN people p ON p.id = par.person_id#(lf)      LEFT JOIN company_place_business_units cpbu ON cpbu.company_place_id = par.company_place_id #(lf)      LEFT JOIN units_measures um ON um.code = sp.code#(lf)      WHERE par.status = 4#(lf)      AND par.deleted IS false#(lf)      --and sp.code = '01481'#(lf)      GROUP BY par.id, sp.code, sp.title, par.date, p.name, par.receipt_date_prevision, pari.units#(lf)      ORDER BY par.date DESC"),
				    #"Linhas Filtradas" = Table.SelectRows(Fonte, each ([BASE] <> "")),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Linhas Filtradas",{{"CÓDIGO", Int64.Type}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

