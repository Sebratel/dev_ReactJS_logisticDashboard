table 'Romaneio de Patrimônios'
	lineageTag: 72ac151a-fedf-4880-b2c6-32aa7aacb4a4

	measure RomaneiosPAT = DISTINCTCOUNT('Romaneio de Patrimônios'[nota_romaneio])
		formatString: 0
		lineageTag: 5ace4a37-fb18-49a0-99bf-7687c3e97aaa

	measure RomaneiosITENS_PAT = COUNT('Romaneio de Patrimônios'[produto_titulo])
		formatString: 0
		lineageTag: 022c7021-438f-4893-af68-467644f1b63e

	measure MEDIA_MENSAL_GERAL_PAT =
			
			AVERAGEX(
			    VALUES('Romaneio de Patrimônios'[AnoMes]),
			    [RomaneiosITENS_PAT]
			)
		formatString: 0
		lineageTag: 6b9bbc14-807d-4fa3-8abf-5ed2ef282524

	measure MEDIA_3_MESES_PAT =
			
			VAR InicioPeriodo =
			    EOMONTH(TODAY(), -4) + 1
			
			VAR FimPeriodo =
			    EOMONTH(TODAY(), -1)
			
			VAR Total3Meses =
			    CALCULATE(
			        [RomaneiosITENS_PAT],
			        FILTER(
			            ALL('Romaneio de Patrimônios'[data_movimento]),
			            'Romaneio de Patrimônios'[data_movimento] >= InicioPeriodo
			                && 'Romaneio de Patrimônios'[data_movimento] <= FimPeriodo
			        )
			    )
			
			RETURN
			    DIVIDE(Total3Meses, 3)
		formatString: 0
		lineageTag: ea4444f5-704c-4f02-8e2e-b70077f67577

	measure MEDIA_MENSAL_PAT =
			
			DIVIDE(
			    [RomaneiosPAT],
			    DISTINCTCOUNT('Romaneio de Patrimônios'[AnoMes])
			)
		formatString: 0
		lineageTag: 657e2fba-3d50-468b-a903-288c532471e0

	column data_movimento
		dataType: dateTime
		formatString: General Date
		lineageTag: 3b629b32-ff67-4eef-b206-0643e0396f45
		summarizeBy: none
		sourceColumn: data_movimento

		variation Variation
			isDefault
			relationship: 6f149c35-0d26-4ff2-aaa7-6d27ee23d09d
			defaultHierarchy: LocalDateTable_49709d53-ed41-4465-9add-1f53b4a78485.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column produto_codigo
		dataType: string
		lineageTag: 37453bdd-4f50-4778-9749-3deac1b6c8cf
		summarizeBy: none
		sourceColumn: produto_codigo

		annotation SummarizationSetBy = Automatic

	column produto_titulo
		dataType: string
		lineageTag: e259af76-61b7-48ab-a1e1-f4d4849d8f1b
		summarizeBy: none
		sourceColumn: produto_titulo

		annotation SummarizationSetBy = Automatic

	column base_descricao
		dataType: string
		lineageTag: 079bff9f-b0d1-4eda-8732-5f050e291182
		summarizeBy: none
		sourceColumn: base_descricao

		annotation SummarizationSetBy = Automatic

	column patrimonio_id
		dataType: int64
		formatString: 0
		lineageTag: 60ecd355-1722-4662-b7d4-02c577659c74
		summarizeBy: sum
		sourceColumn: patrimonio_id

		annotation SummarizationSetBy = Automatic

	column serial
		dataType: string
		lineageTag: b24135f6-300b-4e78-972c-a2bce1ab506b
		summarizeBy: none
		sourceColumn: serial

		annotation SummarizationSetBy = Automatic

	column patrimonio
		dataType: string
		lineageTag: a8def0fa-cca7-436d-8091-3015b0f0a829
		summarizeBy: none
		sourceColumn: patrimonio

		annotation SummarizationSetBy = Automatic

	column nota_romaneio
		dataType: string
		lineageTag: 6d316181-9dbf-483c-bf40-2138ebd58399
		summarizeBy: none
		sourceColumn: nota_romaneio

		annotation SummarizationSetBy = Automatic

	column fornecedor
		dataType: string
		lineageTag: e0cb30dc-4616-45b7-acb6-0955b8471099
		summarizeBy: none
		sourceColumn: fornecedor

		annotation SummarizationSetBy = Automatic

	column recebedor
		dataType: string
		lineageTag: ed9d92f4-1d70-48ce-a81b-9a1edfff009f
		summarizeBy: none
		sourceColumn: recebedor

		annotation SummarizationSetBy = Automatic

	column AnoMes =
			
			YEAR('Romaneio de Patrimônios'[data_movimento]) * 100
			+ MONTH('Romaneio de Patrimônios'[data_movimento])
		formatString: 0
		lineageTag: 8bf7715e-7677-4525-9db6-09536f4c4c42
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'Romaneio de Patrimônios' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "SELECT #(lf)    po.created AS data_movimento,#(lf)    sp.code AS produto_codigo, #(lf)    sp.title AS produto_titulo,  #(lf)    cpbu.description AS base_descricao,  #(lf)    p.id AS patrimonio_id,#(lf)    p.serial_number AS serial,#(lf)    p.tag_number AS patrimonio,#(lf)    -- Extrai apenas os números após Nº ou N°#(lf)    SUBSTRING(po.description FROM 'N[º°]\s*(\d+)') AS nota_romaneio,#(lf)    -- Nome do usuário do sistema que gerou o romaneio#(lf)    u.name AS fornecedor,#(lf)    -- Nome da pessoa/laboratório que recebeu (extraído do texto)#(lf)    RTRIM(#(lf)        SUBSTRING(po.description FROM 'Sob Responsabilidade de\s+(.+)'), #(lf)        ' .'#(lf)    ) AS recebedor#(lf)FROM patrimony_occurrences po#(lf)LEFT JOIN patrimonies p ON p.id = po.patrimony_id#(lf)LEFT JOIN service_products sp ON sp.id = p.service_product_id#(lf)LEFT JOIN company_place_business_units cpbu ON cpbu.id = p.company_place_business_unit_id #(lf)LEFT JOIN companies_places cp ON cp.id = cpbu.company_place_id #(lf)-- Relacionamento para buscar o usuário que criou o movimento#(lf)LEFT JOIN users u ON u.id = po.created_by #(lf)WHERE po.occurrence_type = '5'                      -- Filtra apenas tipo de movimento Técnico/Romaneio#(lf)  AND po.description LIKE '%Sob Responsabilidade de%' -- Garante o padrão do texto#(lf)  AND sp.title IS NOT NULL#(lf)  AND cp.id = 1#(lf)  AND cpbu.description <> 'PROJETO NHO'#(lf)  AND cpbu.deleted IS NOT TRUE#(lf)  AND po.created >= '2026-01-01'                     -- Mantido o filtro de data que você adicionou#(lf)  -- FILTRO DOS USUÁRIOS FORNECEDORES (QUEM MANDOU):#(lf)  AND u.name IN ('ADRIANO ALEXANDRE CRUZ', 'ALEX RAIMUNDO RODRIGUES', 'ALEXANDRE DA SILVA MACIEL', 'BRIAN EDUARDO DOS SANTOS', 'CLOVIS SANTOS DA SILVEIRA',#(lf)'GABRIEL LINHARES', 'GERMANO DE PAULA', 'JESSICA ROCHA MEIRELES', 'JOAO PEDRO DOS SANTOS MARTINS', 'JOÃO PEDRO MACIEL JUNG', 'RAONI SILVA DA SILVA'#(lf)'SAMUEL FIGUEIRA DUTRA', 'VITOR SARAIVA SILVEIRA')#(lf)ORDER BY po.created DESC;                            -- Mais recentes primeiro")
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

