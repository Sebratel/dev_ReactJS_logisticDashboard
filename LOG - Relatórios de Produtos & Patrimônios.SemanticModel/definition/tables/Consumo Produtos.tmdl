	column BaseGrupo =
			
			SWITCH(
			    TRUE(),
			    'Consumo Produtos'[REGIAO] IN {"✅Base São Leopoldo (Ativação)", "✅Base São Leopoldo (Manutenção)", "Estância Velha (EV)", "Novo Hamburgo (NHO)", "São Leopoldo (Manutenção),", "São Leopoldo (SLE)", "✅Sapucaia do Sul (Manutenção)", "Brochier (BCR)", "Sapucaia do Sul (SPS)", "São Leopoldo (Manutenção)."}, "BASE SLE",
			    'Consumo Produtos'[REGIAO] IN {"✅Base Canoas (Ativação)", "✅Base Canoas (Manutenção)", "Canoas (CAN)", "Esteio (EIO)", "Nova Santa Rita (NSR)", "Porto Alegre (POA)", "Triunfo (TNF)"}, "BASE CAN",
			    "OUTROS"
			)
		lineageTag: b29662d4-6d86-4e64-b258-467eea78c676
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Consumo Produtos' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "select#(lf)#(tab)vap.id as ""ID"",#(lf)#(tab)vap.responsible_name as ""TECNICO"",#(lf)#(tab)vap.service_product_code as ""CODIGO"",#(lf)#(tab)vap.service_product_title as ""PRODUTO"",#(lf)#(tab)vap.allocated_amount as ""QTD_ALOCADO"",#(lf)#(tab)vap.first_unit_measure_title as ""MEDIDA"",#(lf)#(tab)vap.invoice_note_document_number as ""NOTA BAIXA"",#(lf)#(tab)i.created as ""CRIADO EM"",#(lf)#(tab)i.issue_date as ""DATA"",#(lf)#(tab)a.title as ""PROTOCOLO"",#(lf)#(tab)r.title as ""REGIAO""#(lf)#(tab)from v_allocated_products vap#(lf)#(tab)left join invoice_notes i on i.id = vap.invoice_note_id#(lf)#(tab)left join people p on p.id = vap.responsible_id#(lf)        left join assignments a on a.id = vap.assignment_id#(lf)        left join regions r on r.id = a.region_id #(lf)        WHERE i.issue_date >= '01-01-2024'#(lf)#(tab)order by vap.id desc"),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"QTD_ALOCADO", Int64.Type}}),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Tipo Alterado", "PROTOCOLO", "PROTOCOLO - Copiar"),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Coluna Duplicada",{{"PROTOCOLO - Copiar", "N° PROTOCOLO"}}),
				    #"Intervalo de Texto Extraído" = Table.TransformColumns(#"Colunas Renomeadas", {{"N° PROTOCOLO", each Text.Middle(_, 10, 7), type text}}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Intervalo de Texto Extraído",{{"CODIGO", Int64.Type}}),
				    #"Consultas Mescladas" = Table.NestedJoin(#"Tipo Alterado1", {"CODIGO"}, #"Controle Estoque", {"CÓDIGO"}, "Controle Estoque", JoinKind.LeftOuter),
				    #"Controle Estoque Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "Controle Estoque", {"SITUAÇÃO"}, {"Controle Estoque.SITUAÇÃO"}),
				    #"Coluna Duplicada1" = Table.DuplicateColumn(#"Controle Estoque Expandido", "CODIGO", "CODIGO - Copiar"),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Coluna Duplicada1",{{"CODIGO - Copiar", "CÓDIGO"}}),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Colunas Renomeadas1",{{"CÓDIGO", type text}})
				in
				    #"Tipo Alterado2"

	annotation PBI_ResultType = Table

