table 'Romaneio Produtos/ Cabos'
	lineageTag: 136f4e03-123e-42c6-9ab3-328b68f9572f

	measure Romaneios = DISTINCTCOUNT('Romaneio Produtos/ Cabos'[document_number])
		formatString: 0
		lineageTag: 8995a4af-9cdf-4d41-bae5-a176676c9b0e

	measure MEDIA_MENSAL =
			
			DIVIDE(
			    [Romaneios],
			    DISTINCTCOUNT('Romaneio Produtos/ Cabos'[AnoMes])
			)
		formatString: 0
		lineageTag: f47ee487-9b8f-4eca-a468-d4a2d6f2f657

	measure MEDIA_3_MESES =
			
			VAR InicioPeriodo =
			    EOMONTH(TODAY(), -4) + 1
			
			VAR FimPeriodo =
			    EOMONTH(TODAY(), -1)
			
			RETURN
			CALCULATE(
			    SUM('Romaneio Produtos/ Cabos'[UNIDADE CONSUMIDA]),
			    FILTER(
			        ALL('Romaneio Produtos/ Cabos'[DATA]),
			        'Romaneio Produtos/ Cabos'[DATA] >= InicioPeriodo
			            && 'Romaneio Produtos/ Cabos'[DATA] <= FimPeriodo
			    )
			) / 3
		formatString: 0
		lineageTag: b5f799d5-c59b-411e-884d-9ebdaa7a0957

	measure MEDIA_MENSAL_GERAL =
			
			AVERAGEX(
			    VALUES('Romaneio Produtos/ Cabos'[AnoMes]),
			    CALCULATE(
			        SUM('Romaneio Produtos/ Cabos'[UNIDADE CONSUMIDA])
			    )
			)
		formatString: 0
		lineageTag: b683e108-355e-4595-9e68-9b4a511c5468

