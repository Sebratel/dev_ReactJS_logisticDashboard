	column AnoMes =
			
			YEAR('Romaneio Produtos/ Cabos'[DATA]) * 100
			+ MONTH('Romaneio Produtos/ Cabos'[DATA])
		formatString: 0
		lineageTag: 0f3b69cd-f7a2-460e-91ca-a908f4e12747
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column CHAVE_PRODUTO_BASE = ```
			'Romaneio Produtos/ Cabos'[CÓDIGO] & "-" & 'Romaneio Produtos/ Cabos'[BASE DE ORIGEM]
			
			```
		lineageTag: acc65f14-898e-41f3-9107-44067193167a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Romaneio Produtos/ Cabos' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "SELECT DISTINCT #(lf)ppm.id,#(lf)ivn.document_number,#(lf)    ppm.units,#(lf)    sp.code,#(lf)    sp.id,#(lf)    sp.title,#(lf)    cpbu.description,#(lf)    ppm.created,#(lf)    p.name,#(lf)    p2.name#(lf)FROM person_product_movimentations ppm#(lf)LEFT JOIN people p ON p.id = ppm.person_id#(lf)LEFT JOIN service_products sp ON sp.id = ppm.service_product_id #(lf)LEFT JOIN units_measures um ON um.id = ppm.first_units_measure_id#(lf)LEFT JOIN v_users p2 ON p2.id = ppm.created_by#(lf)LEFT JOIN company_place_business_units cpbu ON cpbu.id = ppm.company_place_business_unit_id#(lf)LEFT JOIN people_teams pt ON pt.person_id = p.id#(lf)left join invoice_notes ivn on ivn.id = ppm.invoice_note_id #(lf)WHERE ppm.created >= '2025-01-01'#(lf)and p2.name in ('ADRIANO ALEXANDRE CRUZ', 'ALEX RAIMUNDO RODRIGUES', 'ALEXANDRE DA SILVA MACIEL', 'BRIAN EDUARDO DOS SANTOS', 'CLOVIS SANTOS DA SILVEIRA',#(lf)'GABRIEL LINHARES', 'GERMANO DE PAULA', 'JESSICA ROCHA MEIRELES', 'JOAO PEDRO DOS SANTOS MARTINS', 'JOÃO PEDRO MACIEL JUNG', 'RAONI SILVA DA SILVA'#(lf)'SAMUEL FIGUEIRA DUTRA', 'VITOR SARAIVA SILVEIRA')#(lf)  AND sp.""type"" = '1'#(lf)  ---AND sp.code = '00069'#(lf)  AND NOT (#(lf)        DATE(ppm.created) = '2025-09-04'  -- ajusta para o ano correto#(lf)        AND p.name IN (#(lf)            'A.ALMOXARIFADO / SÃO LEO',#(lf)            'A.ALMOXARIFADO / SEDE PORTO ALEGRE',#(lf)            'A.ALMOXARIFADO / CANOAS'#(lf)        )#(lf)  )#(lf)ORDER BY ppm.created DESC;"),
				    #"Colunas Renomeadas" = Table.RenameColumns(Fonte,{{"code", "CÓDIGO"}, {"id", "ID"}, {"title", "DESCRIÇÃO"}, {"units", "UNIDADE CONSUMIDA"}, {"description", "BASE DE ORIGEM"}, {"created", "DATA"}}),
				    #"Linhas Classificadas" = Table.Sort(#"Colunas Renomeadas",{{"DATA", Order.Descending}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Linhas Classificadas",{{"DATA", type date}}),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Tipo Alterado",{{"name", "RECEBEDOR"}, {"name2", "FORNECEDOR"}})
				in
				    #"Colunas Renomeadas1"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

