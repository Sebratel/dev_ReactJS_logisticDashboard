	partition 'Consumo Patrimônios' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "#(tab)select #(lf)#(tab)a.title ""SOLICITACAO"",#(lf)#(tab)ai.protocol ""N°PROTOCOLO"",#(lf)#(tab)p.title ""EQUIPAMENTO"",#(lf)#(tab)p.tag_number ""PATRIMONIO"",#(lf)#(tab)p.serial_number ""SERIAL"",#(lf)#(tab)plis.out_date ""DATA SAIDA"",#(lf)#(tab)plis.created ""DATA HORA SAIDA"",#(lf)#(tab)plis.returned ""STATUS RETORNO"",#(lf)#(tab)plis.returned_date ""DATA DO RETORNO"",#(lf)#(tab)p2.name ""RESPONSAVEL"",#(lf)#(tab)p3.name ""ALOCADO POR:"",#(lf)#(tab)p4.name ""CLIENTE"",#(lf)#(tab)as2.title ""SITE"",#(lf)#(tab)p4.city ""CIDADE"",#(lf)#(tab)aap.title ""PONTO DE ACESSO"",#(lf)        case when p3.outsourced is true then 'TERCEIRO' else 'EFETIVO' END ""POSIÇÃO""#(lf)#(tab)from patrimony_packing_list_items plis#(lf)#(tab)left join patrimony_packing_lists ppl on ppl.id = plis.patrimony_packing_list_id#(lf)#(tab)left join assignments a on a.id = ppl.assignment_id#(lf)#(tab)left join assignment_incidents ai on ai.assignment_id = a.id#(lf)#(tab)left join incident_types it on it.id = ai.incident_type_id#(lf)#(tab)left join patrimonies p on p.id = plis.patrimony_id#(lf)#(tab)left join people p2 on p2.id = plis.created_by#(lf)#(tab)left join people p3 on p3.id = plis.person_allocator_id#(lf)#(tab)left join people p4 on p4.id = ppl.responsible_id#(lf)#(tab)left join authentication_sites as2 on as2.id = ppl.authentication_site_id#(lf)#(tab)left join authentication_access_points aap on aap.id = ppl.authentication_access_point_id#(lf)#(tab)left join solicitation_problems sp on sp.id = ai.solicitation_problem_id #(lf)#(tab)where plis.out_date > '01/01/2024'"),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"STATUS RETORNO", type text}}),
				    #"Valor Substituído" = Table.ReplaceValue(#"Tipo Alterado","1","Retorno",Replacer.ReplaceText,{"STATUS RETORNO"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","0","-",Replacer.ReplaceText,{"STATUS RETORNO"})
				in
				    #"Valor Substituído1"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

