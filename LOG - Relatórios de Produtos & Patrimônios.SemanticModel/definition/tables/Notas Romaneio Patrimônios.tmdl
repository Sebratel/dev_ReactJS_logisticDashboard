	partition 'Notas Romaneio Patrimônios' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "SELECT distinct#(lf)#(tab)u.name ""RESPONSAVEL"",#(lf)    po.created,#(lf)    p2.name ""DASH"",#(lf)    po.id ""ID MOVIMENTO"",#(lf)#(tab)p.id ""ID PATRIMONIO"",#(lf)#(tab)p.serial_number ""N°PATRIMONIO"",#(lf)#(tab)p.tag_number ""SERIAL"",#(lf)#(tab)p.title ""DESCRICAO"",#(lf)#(tab)p.created ""CRIADO EM:"",#(lf)#(tab)p.deleted ""DELETADO:"",#(lf)#(tab)p.p_is_disponible ""DISPONIVEL:"",#(lf)#(tab)po.date ""DATA MOVIMENTADA:"",#(lf)#(tab)SUBSTRING(po.description FROM 'Sob Responsabilidade de (.+)') AS ""RECEBIDO POR:""#(lf)#(tab)FROM patrimony_occurrences po#(lf)#(tab)LEFT JOIN patrimonies p on p.id = po.patrimony_id#(lf)#(tab)LEFT JOIN people p2 on p2.id = p.person_id#(lf)#(tab)left join users u on u.id = po.created_by#(lf)#(tab)where po.date >= '2024-01-01'"),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"CRIADO EM:", type date}}),
				    #"Valor Substituído" = Table.ReplaceValue(#"Tipo Alterado","0","INDISPONÍVEL",Replacer.ReplaceText,{"DISPONIVEL:"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","1","DISPONÍVEL",Replacer.ReplaceText,{"DISPONIVEL:"}),
				    #"Linhas Classificadas" = Table.Sort(#"Valor Substituído1",{{"DATA MOVIMENTADA:", Order.Descending}})
				in
				    #"Linhas Classificadas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

