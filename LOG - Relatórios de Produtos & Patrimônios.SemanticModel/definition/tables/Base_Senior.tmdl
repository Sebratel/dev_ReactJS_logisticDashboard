table Base_Senior
	lineageTag: 6884cbe2-1408-4878-b6fa-94fa1b11e17f

	column name
		dataType: string
		lineageTag: 5ebf36ee-ba69-4bb4-a64f-aa1d4eb670d5
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = Automatic

	column registration
		dataType: int64
		formatString: 0
		lineageTag: 105fb970-9473-4472-b6ef-27c2dd45de01
		summarizeBy: sum
		sourceColumn: registration

		annotation SummarizationSetBy = Automatic

	column operational_base
		dataType: string
		lineageTag: 5ef2e76a-a204-47cf-8c72-95845c1571be
		summarizeBy: none
		sourceColumn: operational_base

		annotation SummarizationSetBy = Automatic

	column team
		dataType: string
		lineageTag: bf1be2f7-4631-4412-a8c9-34fd86037ee5
		summarizeBy: none
		sourceColumn: team

		annotation SummarizationSetBy = Automatic

	partition Base_Senior = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbMaria", "WITH ranked AS (#(lf)    SELECT sn.name,#(lf)           sn.registration,#(lf)           sn.operational_base,#(lf)           sn.team,#(lf)           ROW_NUMBER() OVER (PARTITION BY sn.name ORDER BY sn.registration DESC) AS rn#(lf)    FROM API_WebDeveloper.db_senior_collaborators sn#(lf))#(lf)SELECT name,#(lf)       registration,#(lf)       operational_base,#(lf)       team#(lf)FROM ranked#(lf)WHERE rn = 1;")
				in
				    Fonte

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

