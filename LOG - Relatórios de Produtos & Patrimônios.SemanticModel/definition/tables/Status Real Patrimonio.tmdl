table 'Status Real Patrimonio'
	lineageTag: 1a68649e-cca5-45ff-9321-9eddaebf859f

	measure Qtd_Disponivel = ```
			
			CALCULATE(
			    COUNT('Status Real Patrimonio'[patrimonio_id]), 
			    'Status Real Patrimonio'[Status Atual] = "Disponível"
			)
			```
		formatString: 0
		lineageTag: a070a205-4fe9-4a43-ba31-9e7bb9d34b5e

	measure Qtd_Indisponivel = ```
			
			CALCULATE(
			    COUNT('Status Real Patrimonio'[patrimonio_id]), 
			    'Status Real Patrimonio'[Status Atual] = "Indisponível"
			)
			```
		formatString: 0
		lineageTag: bb956f48-af8a-4c65-8e21-fd7c34f74634

