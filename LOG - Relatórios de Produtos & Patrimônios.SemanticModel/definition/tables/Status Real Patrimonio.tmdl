		sourceColumn: Base_Senior.team

		annotation SummarizationSetBy = Automatic

	partition 'Status Real Patrimonio' = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=dbVoalle", "WITH ultimas_ocorrencias AS (#(lf)    SELECT#(lf)        p.id AS patrimonio_id,#(lf)        p.serial_number AS serial,#(lf)        p.tag_number AS patrimonio,#(lf)        p.p_is_disponible,#(lf)        p.last_occurrence_description,#(lf)        p.service_product_id,#(lf)        p.company_place_business_unit_id,#(lf)        po.occurrence_type,#(lf)        po.title AS ocorrencia_titulo,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY po.patrimony_id#(lf)            ORDER BY po.id DESC, po.date DESC#(lf)        ) AS rn#(lf)    FROM patrimony_occurrences po#(lf)    LEFT JOIN patrimonies p ON p.id = po.patrimony_id#(lf)    ---WHERE pt.service_product_id IN ('02156','02845','03188','03693','03934','03935','04000','05601')#(lf))#(lf)SELECT #(lf)    sp.id AS produto_id, #(lf)    sp.code AS produto_codigo, #(lf)    sp.title AS produto_titulo,  #(lf)    p.title as patrimonio_titulo,#(lf)    pe.name as responsavel,#(lf)    cpbu.description AS base_descricao,  #(lf)    uo.patrimonio_id,#(lf)    uo.serial,#(lf)    uo.patrimonio,#(lf)    CASE #(lf)        WHEN uo.occurrence_type IN ('12', '23') THEN 'Aguardando Retorno'#(lf)        WHEN uo.occurrence_type = '33' THEN 'Extraviado'#(lf)        WHEN uo.occurrence_type = '13' THEN 'Descarte'#(lf)        WHEN uo.occurrence_type = '28' THEN 'Vendido'#(lf)        WHEN uo.occurrence_type = '2'  THEN 'Alocado Cliente'#(lf)        WHEN uo.occurrence_type = '15' THEN 'Alocado Site'#(lf)        WHEN uo.occurrence_type = '5' THEN #(lf)            CASE #(lf)                WHEN (uo.last_occurrence_description LIKE '%MANUTENÇÃO / LABORATÓRIO / CANOAS%' OR #(lf)                      uo.last_occurrence_description LIKE '%CANCELAMENTO / LABORATÓRIO / SLE%') #(lf)                     AND TRIM(uo.last_occurrence_description) LIKE '%.'#(lf)                THEN 'Resp. Lab'#(lf)                WHEN (uo.last_occurrence_description LIKE '%MANUTENÇÃO / LABORATÓRIO / CANOAS%' OR #(lf)                      uo.last_occurrence_description LIKE '%CANCELAMENTO / LABORATÓRIO / SLE%')#(lf)                THEN 'Aguardando Retorno'#(lf)                ELSE 'Resp. Técnico'#(lf)            END#(lf)        WHEN uo.p_is_disponible = true OR uo.p_is_disponible IS TRUE THEN 'Disponível'#(lf)        WHEN uo.occurrence_type IN ('6', '10', '1') OR uo.ocorrencia_titulo LIKE '%Disponível%' THEN 'Disponível'#(lf)        ELSE 'Outros (' || COALESCE(uo.ocorrencia_titulo, 'Sem Histórico') || ')'#(lf)    END AS ""Status Atual""#(lf)FROM ultimas_ocorrencias uo#(lf)LEFT JOIN service_products sp ON sp.id = uo.service_product_id#(lf)LEFT JOIN company_place_business_units cpbu ON cpbu.id = uo.company_place_business_unit_id #(lf)LEFT JOIN companies_places cp ON cp.id = cpbu.company_place_id#(lf)left join patrimonies p on p.id = uo.patrimonio_id#(lf)left join people pe on pe.id = p.person_id#(lf)WHERE uo.rn = 1 #(lf)  AND sp.title IS NOT NULL#(lf)  AND cp.id = 1#(lf)  AND cpbu.description <> 'PROJETO NHO'#(lf)  AND cpbu.deleted IS NOT TRUE;"),
				    #"Consultas Mescladas" = Table.NestedJoin(Fonte, {"responsavel"}, Base_Senior, {"name"}, "Base_Senior", JoinKind.LeftOuter),
				    #"Base_Senior Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "Base_Senior", {"operational_base", "team"}, {"Base_Senior.operational_base", "Base_Senior.team"})
				in
				    #"Base_Senior Expandido"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

