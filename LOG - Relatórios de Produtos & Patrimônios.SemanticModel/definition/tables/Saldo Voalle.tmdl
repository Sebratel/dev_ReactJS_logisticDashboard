	column STATUS2 = ```
			
			VAR Alerta =
			    LOOKUPVALUE(
			        'Controle Estoque'[ALERTA ESTOQUE],
			        'Controle Estoque'[CÓDIGO], 'Saldo Voalle'[CÓDIGO],
			        'Controle Estoque'[BASE DE ORIGEM], 'Saldo Voalle'[BASE DE ORIGEM]
			    )
			VAR Minimo =
			    LOOKUPVALUE(
			        'Controle Estoque'[ESTOQUE MÍNIMO],
			        'Controle Estoque'[CÓDIGO], 'Saldo Voalle'[CÓDIGO],
			        'Controle Estoque'[BASE DE ORIGEM], 'Saldo Voalle'[BASE DE ORIGEM]
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    'Saldo Voalle'[UNIDADES] <= Minimo, "MÍNIMO",
			    'Saldo Voalle'[UNIDADES] <= Alerta, "ALERTA",
			    "ACIMA"
			)
			
			```
		lineageTag: ee2c0657-efa6-45e1-88ec-ba4255c8cc70
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ESTOQUE MÍNIMO'
		dataType: int64
		formatString: 0
		lineageTag: bcaa38f3-7682-404e-8387-52d75dd863a9
