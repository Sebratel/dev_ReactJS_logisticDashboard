	column '% EXCESSO' = ```
			IF('Saldo Voalle'[UNIDADES] > 'Saldo Voalle'[ESTOQUE MÍNIMO] * 1.25, 
			             'Saldo Voalle'[UNIDADES] * 0.25, 
			             0)
			```
		formatString: 0
		lineageTag: ffad223f-839f-4db9-bdbc-aa07799595a0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% DEFICIT' = ```
			IF('Saldo Voalle'[UNIDADES] < 'Saldo Voalle'[ESTOQUE MÍNIMO], 
			             'Saldo Voalle'[ESTOQUE MÍNIMO] - 'Saldo Voalle'[UNIDADES], 
			             0)
			```
		formatString: 0
		lineageTag: cd9db0d5-1e3b-400e-9db7-5a4cd9a6b282
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '% QTD TRANFERIR' = ```
			
			VAR DeficitAtual = 'Saldo Voalle'[% DEFICIT]
			VAR Produto = 'Saldo Voalle'[CÓDIGO]
			
			-- Total de EXCESSO disponível para o mesmo CÓDIGO, somando entre todas as bases operacionais do produto
			VAR TotalDisponivelParaTransferencia = 
			    CALCULATE(
			        SUM('Saldo Voalle'[% EXCESSO]),
			        FILTER(
			            'Saldo Voalle',
			            'Saldo Voalle'[CÓDIGO] = Produto  -- Aplica o filtro explicitamente para o mesmo código do produto atual
			        )
			    )
			
			RETURN
			    -- Verifica se o produto atual tem déficit e se o total de excesso disponível é suficiente para cobrir o déficit
			    IF(DeficitAtual > 0 && TotalDisponivelParaTransferencia >= DeficitAtual, TotalDisponivelParaTransferencia, 0)
			
			```
		dataType: int64
		formatString: 0
		lineageTag: 5c524dbe-0066-43fb-9b86-f22bb91cb79e
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

