# Power BI: os relatórios de origem (.pbip e as pastas .Report/.SemanticModel) ficam só na
# máquina — o repositório guarda o app. O cache do modelo tem dado real.
*.pbip
*.pbix
*.pbit
*.Report/
*.SemanticModel/
**/.pbi/

# dependências e artefatos de build
node_modules/
dist/
server/public/
server/.source-cache/
# dados gravados pelo app (cadastro de controle de estoque) — o versionado é a semente
server/data/
# dados da API de teste local (launch.json "api-teste", sem login, porta 8090)
server/.teste-data/

# segredos — NUNCA versionar (use .env.example como modelo)
.env
.env.*
!.env.example
*.pem
service-account*.json

# diversos
*.log
.DS_Store
Thumbs.db
